---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CALENDLY_URL, CONTACT_EMAIL } from '../consts';
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Book me — Aswani Karteek Yadavilli" description="Book time with Aswani Karteek Yadavilli for keynotes, advisory, training, and mentorship." /></head>
  <body>
    <Header />
    <main>
      <section class="book">
        <h1>Let's work together</h1>
        {CALENDLY_URL ? (
          <p>Pick a time below, or email me at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with what you have in mind.</p>
        ) : (
          <p>Email me at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with what you have in mind — what you're working on, rough timing, and the format you're after.</p>
        )}

        {CALENDLY_URL && (
          <Fragment>
            <div class="calendly-inline-widget" data-url={CALENDLY_URL} style="min-width:320px;height:700px;"></div>
            <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
          </Fragment>
        )}
      </section>
    </main>
    <Footer />
    <style>
      .book { max-width: 760px; margin: 0 auto; }
    </style>
  </body>
</html>
